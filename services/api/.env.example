# Chill API configuration. Copy to `.env` for local runs.
# Never commit a real `.env`; it is gitignored.

CHILL_ENV=development
CHILL_DATABASE_URL=postgresql+asyncpg://chill:chill@localhost:5432/chill

# Base64-encoded 32-byte AES-256 key for embedding encryption.
# Generate with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
CHILL_ENCRYPTION_KEY=

# HMAC key for hashing device access tokens.
CHILL_TOKEN_SIGNING_KEY=

# Rate limits and lockout.
CHILL_VERIFICATION_RATE_LIMIT=10
CHILL_ENROLLMENT_RATE_LIMIT=10
CHILL_RATE_LIMIT_WINDOW_SECONDS=60
CHILL_MAX_VERIFICATION_ATTEMPTS=3
CHILL_LOCKOUT_SECONDS=300

# Similarity threshold for verification. The default suits ECAPA-TDNN, where
# same-speaker scores are ~0.84-0.92 and different-speaker ~0.12-0.18. Re-tune
# against real field recordings before relying on it in production.
CHILL_VERIFICATION_THRESHOLD=0.55
CHILL_HIGH_CONFIDENCE_THRESHOLD=0.75
CHILL_MEDIUM_CONFIDENCE_THRESHOLD=0.65

# Speaker encoder: "placeholder" (deterministic, for tests) or "ecapa" (real).
CHILL_EMBEDDING_PROVIDER=placeholder
CHILL_MODEL_CACHE_DIR=./.models
CHILL_MODEL_DEVICE=cpu

# Sample quality gates, applied after decoding and voice activity detection.
CHILL_MIN_SPEECH_MS=1200
CHILL_MIN_SNR_DB=8.0
CHILL_MAX_CLIPPING_RATIO=0.05

# Stronger voice auth (v0.5).

# Bind the voice profile to the device that enrolled it. Verification from
# another device is refused. Turn off to let the same owner verify from a
# second device.
CHILL_ENFORCE_DEVICE_BINDING=true

# Require a single-use, time-boxed nonce with each verification. The client
# gets one from POST /v1/verification/challenge and returns its id with the
# recording. This is a freshness check, not full liveness detection.
CHILL_REQUIRE_VERIFICATION_CHALLENGE=true
CHILL_CHALLENGE_TTL_SECONDS=120
CHILL_CHALLENGE_RATE_LIMIT=30

# How long a used recording is remembered so it cannot be replayed.
CHILL_REPLAY_WINDOW_SECONDS=600

# Audit log retention.
CHILL_AUDIT_LOG_RETENTION_DAYS=90
